{
  "name": "@dbinsight/core",
  "version": "0.0.0",
  "private": true,
  "description": "Static analysis core for Prisma/PostgreSQL applications",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
