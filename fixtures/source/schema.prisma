// Shared schema for analyzer source fixtures. Model names are deliberately
// generic and unrelated to the test applications.

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  OPEN
  DONE
}

model Team {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  users    User[]
  projects Project[]
  invoices Invoice[]
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  active    Boolean  @default(true)
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id])
  createdAt DateTime @default(now())
  tasks     Task[]

  @@index([teamId, createdAt])
}

model Project {
  id        Int      @id @default(autoincrement())
  name      String
  archived  Boolean  @default(false)
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id])
  createdAt DateTime @default(now())
  tasks     Task[]

  @@index([teamId, createdAt])
}

model Task {
  id         Int        @id @default(autoincrement())
  title      String
  status     TaskStatus @default(OPEN)
  projectId  Int
  project    Project    @relation(fields: [projectId], references: [id])
  assigneeId Int?
  assignee   User?      @relation(fields: [assigneeId], references: [id])
  dueAt      DateTime?
  createdAt  DateTime   @default(now())

  @@index([projectId, createdAt])
  @@index([assigneeId])
}

model Invoice {
  id          Int      @id @default(autoincrement())
  number      String   @unique
  teamId      Int
  team        Team     @relation(fields: [teamId], references: [id])
  amountCents Int
  memo        String?
  issuedAt    DateTime @default(now())
}
