{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The splash screen: the app's own commands, the folder picker, and opening links",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:default",
    "allow-get-config",
    "allow-set-home",
    "allow-start-services",
    "allow-stop-services",
    "allow-read-log",
    "allow-open-logs-folder"
  ]
}
