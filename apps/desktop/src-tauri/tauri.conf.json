{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DBInsight",
  "version": "0.1.0",
  "identifier": "edu.juniv.dbinsight",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Database performance and data quality, from evidence",
    "longDescription": "DBInsight correlates source code, schema, queries and data to find database performance and data-quality problems in Prisma applications, and shows the evidence behind each finding.",
    "copyright": "Research prototype, IIT Jahangirnagar University",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
